@using Dressly_MVC.Models
@model Dressly_MVC.ViewModels.PerfilViewModel
@{
    ViewData["Title"] = "Mi Perfil";
    var perfil = Model.Perfil;
}

<div class="section-header d-flex justify-content-between align-items-center">
    <h2 class="mb-0">Mi Perfil</h2>
    <a asp-action="Editar" class="btn btn-blush px-4 btn-pill">
        <i class="bi bi-pencil-square me-1"></i> Editar perfil
    </a>
</div>

@if (perfil == null)
{
    <div class="empty-state">
        <div class="empty-icon"><i class="bi bi-person-circle"></i></div>
        <h5 class="text-graphite">Aun no has configurado tu perfil fisico</h5>
        <p class="small text-slate mb-3">
            Configura tu tipo de cuerpo, colorimetria y contraste personal para recibir sugerencias personalizadas.
        </p>
        <a asp-action="Editar" class="btn btn-blush mt-2 btn-pill">
            <i class="bi bi-pencil-square me-1"></i> Configurar mi perfil
        </a>
    </div>
}
else
{
    <div class="row g-4">

        <!-- Resumen -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-4 flex-wrap py-4 px-4">
                    <div class="avatar-glow">
                        @if (!string.IsNullOrEmpty(perfil.FotoUrl))
                        {
                            <img src="@perfil.FotoUrl" alt="Foto de perfil"
                                 style="width:72px;height:72px;" />
                        }
                        else
                        {
                            <div style="width:72px;height:72px;border-radius:50%;background:var(--gradient-blush);display:flex;align-items:center;justify-content:center;font-size:1.5rem;color:white;flex-shrink:0;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }
                    </div>
                    <div>
                        <div class="fw-semibold" style="font-family:var(--font-display); font-size:1.1rem;">@perfil.TipoCuerpo</div>
                        <div class="small" style="color:var(--slate);">
                            @perfil.Colorimetria &middot; Contraste @perfil.Contraste &middot; @perfil.SubtonoPiel
                        </div>
                    </div>
                    <div class="ms-auto text-end">
                        <div class="small" style="color:var(--slate);">@(perfil.Altura?.ToString("F2") ?? "--") m</div>
                        <div class="small" style="color:var(--slate);">@perfil.IntensidadCabello &middot; @perfil.ColorOjos</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tipo de cuerpo -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header">
                    Tipo de cuerpo: @perfil.TipoCuerpo
                </div>
                <div class="card-body">
                    @if (Model.TipoCuerpoInfo != null)
                    {
                        <p class="mb-3" style="color:var(--charcoal); font-size:0.875rem;">
                            @Model.TipoCuerpoInfo.Descripcion
                        </p>

                        <h6 class="fw-semibold mb-2" style="color:var(--carbon); font-size:0.8125rem; letter-spacing:0.03em;">
                            CARACTERISTICAS
                        </h6>
                        <ul class="mb-3 ps-3" style="font-size:0.8125rem;">
                            @foreach (var c in Model.TipoCuerpoInfo.Caracteristicas)
                            {
                                <li class="mb-1" style="color:var(--slate);">@c</li>
                            }
                        </ul>

                        <h6 class="fw-semibold mb-2" style="color:var(--success); font-size:0.8125rem; letter-spacing:0.03em;">
                            PRENDAS RECOMENDADAS
                        </h6>
                        <ul class="mb-3 ps-3" style="font-size:0.8125rem;">
                            @foreach (var r in Model.TipoCuerpoInfo.PrendasRecomendadas)
                            {
                                <li class="mb-1" style="color:var(--success);">@r</li>
                            }
                        </ul>

                        <h6 class="fw-semibold mb-2" style="color:var(--danger); font-size:0.8125rem; letter-spacing:0.03em;">
                            PRENDAS A EVITAR
                        </h6>
                        <ul class="mb-0 ps-3" style="font-size:0.8125rem;">
                            @foreach (var e in Model.TipoCuerpoInfo.PrendasEvitar)
                            {
                                <li class="mb-1" style="color:var(--danger);">@e</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="small" style="color:var(--mist);">Selecciona tu tipo de cuerpo en la edicion de perfil.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Colorimetria -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Colorimetria: @perfil.Colorimetria</span>
                    @if (Model.ColorimetriaInfo != null)
                    {
                        <span class="badge bg-orchid">
                            @(Model.ColorimetriaInfo.ColoresPrincipales.Count + Model.ColorimetriaInfo.ColoresComplementarios.Count + Model.ColorimetriaInfo.ColoresNeutros.Count) colores
                        </span>
                    }
                </div>
                <div class="card-body">
                    @if (Model.ColorimetriaInfo != null)
                    {
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="season-badge season-@(perfil.Colorimetria?.ToLower())">
                                @perfil.Colorimetria?.Substring(0, 1)
                            </div>
                            <div>
                                <p class="fw-semibold mb-0" style="color:var(--carbon);">@perfil.Colorimetria</p>
                                <p class="small mb-0" style="color:var(--slate);">Tono de piel: @perfil.TonoPiel</p>
                            </div>
                        </div>

                        <h6 class="fw-semibold mb-2" style="color:var(--carbon); font-size:0.8125rem; letter-spacing:0.03em;">
                            COMO IDENTIFICARLO
                        </h6>
                        <ul class="mb-3 ps-3" style="font-size:0.8125rem;">
                            @foreach (var c in Model.ColorimetriaInfo.Caracteristicas)
                            {
                                <li class="mb-1" style="color:var(--slate);">@c</li>
                            }
                        </ul>

                        <div class="border-start ps-3 mb-3"
                             style="border-color:var(--orchid); background-color:var(--orchid-pale); border-radius:0 var(--radius-sm) var(--radius-sm) 0; padding:12px;">
                            <h6 class="fw-semibold mb-1" style="color:var(--carbon); font-size:0.75rem; letter-spacing:0.03em;">
                                POR QUE ESTOS COLORES
                            </h6>
                            <p class="mb-0" style="font-size:0.8125rem; color:var(--charcoal);">
                                @Model.ColorimetriaInfo.Explicacion
                            </p>
                        </div>

                        <div class="palette-group">
                            <h6>COLORES PRINCIPALES</h6>
                            <div class="palette-colors">
                                @foreach (var (nombre, hex) in Model.ColorimetriaInfo.ColoresPrincipales)
                                {
                                    <div class="color-swatch">
                                        <div class="color-dot" style="background-color:@hex;"></div>
                                        <span>@nombre</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="palette-group">
                            <h6 style="color:var(--orchid-deep);">COLORES COMPLEMENTARIOS</h6>
                            <div class="palette-colors">
                                @foreach (var (nombre, hex) in Model.ColorimetriaInfo.ColoresComplementarios)
                                {
                                    <div class="color-swatch">
                                        <div class="color-dot" style="background-color:@hex;"></div>
                                        <span>@nombre</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="palette-group">
                            <h6 style="color:var(--mist);">NEUTROS</h6>
                            <div class="palette-colors">
                                @foreach (var (nombre, hex) in Model.ColorimetriaInfo.ColoresNeutros)
                                {
                                    <div class="color-swatch">
                                        <div class="color-dot" style="background-color:@hex;"></div>
                                        <span>@nombre</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="small" style="color:var(--mist);">Selecciona tu colorimetria en la edicion de perfil.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Contraste -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    Contraste personal: @perfil.Contraste
                </div>
                <div class="card-body">
                    @if (Model.ContrasteInfo != null)
                    {
                        <div class="row g-4">
                            <div class="col-md-4">
                                <p class="mb-0" style="font-size:0.875rem; color:var(--charcoal);">
                                    @Model.ContrasteInfo.Descripcion
                                </p>
                            </div>
                            <div class="col-md-4">
                                <div class="border-start ps-3 h-100"
                                     style="border-color:var(--orchid);">
                                    <h6 class="fw-semibold mb-2" style="color:var(--carbon); font-size:0.8125rem; letter-spacing:0.03em;">
                                        EXPLICACION
                                    </h6>
                                    <p class="mb-0" style="font-size:0.8125rem; color:var(--slate);">
                                        @Model.ContrasteInfo.Explicacion
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <h6 class="fw-semibold mb-2" style="color:var(--success); font-size:0.8125rem; letter-spacing:0.03em;">
                                    RECOMENDACIONES
                                </h6>
                                <ul class="mb-0 ps-3" style="font-size:0.8125rem;">
                                    @foreach (var r in Model.ContrasteInfo.Recomendaciones)
                                    {
                                        <li class="mb-1" style="color:var(--success);">@r</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="small" style="color:var(--mist);">Selecciona tu nivel de contraste en la edicion de perfil.</p>
                    }
                </div>
            </div>
        </div>

    </div>
}
