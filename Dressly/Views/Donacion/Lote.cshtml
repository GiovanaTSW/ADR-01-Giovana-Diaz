@model List<Prenda>
@{
    ViewData["Title"] = "Crear Lote de Donación";
    var puntos = ViewBag.Puntos as List<PuntoONG> ?? new();
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="section-header mb-4">
            <h2 class="mb-1">Crear lote de donación</h2>
            <p class="small" style="color:var(--slate);">Selecciona las prendas que quieres donar y el punto de entrega.</p>
        </div>

        @if (!Model.Any())
        {
            <div class="alert text-center py-4"
                 style="background-color:var(--surface-muted); border-color:var(--border-light);">
                <h6 class="fw-semibold" style="color:var(--carbon);">No tienes prendas disponibles para donar</h6>
                <p class="small mb-3" style="color:var(--slate);">
                    Las prendas marcadas como en desuso o sin uso por más de 90 días aparecerán aquí.
                </p>
                <a asp-controller="Prenda" asp-action="Index" class="btn btn-sm px-4"
                   style="background-color:var(--carbon); color:white; border-color:var(--carbon);">
                    Ir a mi guardarropa
                </a>
            </div>
        }
        else
        {
            <form asp-action="Lote" method="post">
                @Html.AntiForgeryToken()

                <!-- Prendas en desuso -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header">
                        Prendas disponibles para donar
                    </div>
                    <div class="card-body">
                        <p class="small mb-3" style="color:var(--slate);">Selecciona las prendas que deseas incluir en este lote.</p>
                        <div class="row g-2">
                            @foreach (var prenda in Model)
                            {
                                <div class="col-sm-6">
                                    <div class="form-check p-3"
                                         style="border:1px solid var(--border-light); border-radius:var(--radius-sm);">
                                        <input class="form-check-input" type="checkbox"
                                               name="prendaIds" value="@prenda.Id"
                                               id="prenda_@prenda.Id" />
                                        <label class="form-check-label w-100" for="prenda_@prenda.Id">
                                            @if (!string.IsNullOrEmpty(prenda.FotoUrl))
                                            {
                                                <img src="@prenda.FotoUrl" alt="@prenda.Nombre"
                                                     class="w-100 mb-2 img-editorial"
                                                     style="height:80px;" />
                                            }
                                            <div class="fw-semibold small" style="font-family:var(--font-display);">@prenda.Nombre</div>
                                            <div style="font-size:0.7rem; color:var(--mist);">
                                                @prenda.Categoria &middot; @prenda.Color &middot; @prenda.Talla
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Punto ONG -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header">
                        Punto de entrega
                    </div>
                    <div class="card-body">
                        <p class="small mb-3" style="color:var(--slate);">Elige la ONG donde llevarás las prendas.</p>
                        @foreach (var punto in puntos)
                        {
                            <div class="form-check p-3 mb-2"
                                 style="border:1px solid var(--border-light); border-radius:var(--radius-sm);">
                                <input class="form-check-input" type="radio"
                                       name="puntoONGId" value="@punto.Id"
                                       id="ong_@punto.Id" required />
                                <label class="form-check-label" for="ong_@punto.Id">
                                    <div class="fw-semibold" style="font-family:var(--font-display);">@punto.Nombre</div>
                                    <div class="small" style="color:var(--slate);">@punto.Direccion</div>
                                    <div class="small" style="color:var(--mist);">@punto.Telefono</div>
                                </label>
                            </div>
                        }
                        <div class="mt-3 text-center">
                            <button type="button" class="btn btn-outline-secondary btn-sm px-3 btn-pill"
                                    data-bs-toggle="modal" data-bs-target="#modalAgregarPunto">
                                <i class="bi bi-plus-lg me-1"></i> Agregar punto ONG
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Botones -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn text-white px-4 fw-semibold"
                            style="background-color:var(--carbon); border-color:var(--carbon);">
                        Crear lote de donación
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        Cancelar
                    </a>
                </div>

            </form>
        }

    </div>
</div>

<!-- Modal Agregar Punto ONG -->
<div class="modal fade" id="modalAgregarPunto" tabindex="-1"
     aria-labelledby="modalAgregarPuntoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="AgregarPuntoONG" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title" id="modalAgregarPuntoLabel" style="font-family:var(--font-display);">
                    Agregar punto ONG
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Nombre</label>
                    <input type="text" name="nombre" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Dirección</label>
                    <!-- id="direccion" agregado para auto-completar desde JS -->
                    <input type="text" name="direccion" id="direccion" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Teléfono</label>
                    <input type="text" name="telefono" class="form-control" />
                </div>

                <!-- Contenedor del Mapa -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold d-block">Seleccionar ubicación en el mapa</label>
                    <div id="map" style="height: 220px; width: 100%; border-radius: var(--radius-sm, 8px); border: 1px solid var(--border-light, #ccc);"></div>
                    <small class="text-muted" style="font-size:0.75rem;">Haz clic o arrastra el marcador para fijar la ubicación.</small>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Latitud</label>
                        <input type="number" step="any" name="latitud" id="latitud" class="form-control" readonly />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Longitud</label>
                        <input type="number" step="any" name="longitud" id="longitud" class="form-control" readonly />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-pill px-3"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="submit" class="btn btn-blush btn-pill px-3">
                    <i class="bi bi-plus-lg me-1"></i> Agregar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <!-- Script JS de Leaflet -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        // Coordenadas iniciales (Mérida)
        const initialLat = 20.9676;
        const initialLng = -89.5926;

        const map = L.map('map').setView([initialLat, initialLng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap'
        }).addTo(map);

        // Marcador arrastrable
        let marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);

        // Geocodificación Inversa (Obtiene la dirección según Lat y Lng)
        async function reverseGeocode(lat, lng) {
        const inputDireccion = document.getElementById('direccion');
        if (!inputDireccion) return;

        inputDireccion.placeholder = "Obteniendo dirección...";

        try {
        const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`);
        const data = await response.json();

        if (data && data.address) {
        const addr = data.address;
        let parts = [];

        if (addr.road) parts.push(addr.road);
        if (addr.house_number) parts.push(`#${addr.house_number}`);
        if (addr.suburb || addr.neighbourhood) parts.push(addr.suburb || addr.neighbourhood);
        if (addr.city || addr.town) parts.push(addr.city || addr.town);

        inputDireccion.value = parts.length > 0 ? parts.join(', ') : data.display_name;
        }
        } catch (error) {
        console.error("Error al obtener la dirección:", error);
        }
        }

        // Actualiza inputs numéricos y consulta la dirección
        function updateInputs(lat, lng) {
        document.getElementById('latitud').value = lat.toFixed(6);
        document.getElementById('longitud').value = lng.toFixed(6);
        reverseGeocode(lat, lng);
        }

        // Asignar valores por defecto al cargar
        updateInputs(initialLat, initialLng);

        // Evento al hacer clic en cualquier punto del mapa
        map.on('click', function (e) {
        marker.setLatLng(e.latlng);
        updateInputs(e.latlng.lat, e.latlng.lng);
        });

        // Evento al arrastrar el pin
        marker.on('dragend', function (e) {
        const position = marker.getLatLng();
        updateInputs(position.lat, position.lng);
        });

        // Reajustar mapa al abrir la modal de Bootstrap
        const modalEl = document.getElementById('modalAgregarPunto');
        if (modalEl) {
        modalEl.addEventListener('shown.bs.modal', function () {
        map.invalidateSize();
        });
        }
        });
    </script>
}